{
  "name": "@astropods/github-issue-analyzer",
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub Issue Analyzer — ingests GitHub issues into a Neo4j knowledge graph with OpenAI-powered analysis",
  "scripts": {
    "dev": "bun --watch agent/index.ts",
    "dev:ingest": "bun --watch ingestion/index.ts",
    "start": "bun agent/index.ts",
    "ingest": "bun ingestion/index.ts",
    "test:unit": "vitest run --project unit",
    "test:evals": "vitest run --project evals",
    "test:dump": "bun test/dump-fixtures.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "main": "./agent/index.ts",
  "dependencies": {
    "@astropods/adapter-mastra": "^0.7.1",
    "@mastra/core": "^1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "neo4j-driver": "^5.28.1",
    "openai": "^4.104.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mastra/evals": "^1.10.0",
    "@testcontainers/neo4j": "^10.0.0",
    "@types/bun": "^1.1.14",
    "testcontainers": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
