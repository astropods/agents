# =============================================================================
# GitHub Issue Analyzer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For local dev:     ast dev
# For deployment:    ast deploy
# =============================================================================

# AI gateway — powers the agent and ingestion analysis with Claude models.
# `ast login` followed by `ast dev` injects both of these, so leave them unset
# unless you are pointing at a gateway by hand.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=

# Optional model overrides. Defaults are claude-sonnet-4-6 and claude-haiku-4-5.
# MODEL_REASONING=
# MODEL_FAST=

# GitHub personal access token — used by the ingestion pipeline to fetch issues
# Needs at least `public_repo` scope (or `repo` for private repositories)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
