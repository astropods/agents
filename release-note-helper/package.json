{
  "name": "@astropods/release-note-helper",
  "version": "0.1.0",
  "type": "module",
  "description": "An agent that helps you craft release notes from Jira issues and GitHub PRs",
  "scripts": {
    "dev": "bun --watch agent/index.ts",
    "start": "bun agent/index.ts",
    "test:unit": "vitest run --project unit",
    "test:evals": "vitest run --project evals",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "main": "./agent/index.ts",
  "dependencies": {
    "@astropods/adapter-mastra": "^0.7.1",
    "@mastra/core": "^1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "ioredis": "^5.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mastra/evals": "^1.10.0",
    "@types/bun": "^1.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
