{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["agent/**/*", "src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "agent/tools/github.test.ts",
    "agent/tools/jira.test.ts",
    "agent/tools/preferences.test.ts",
    "test/evals/**"
  ]
}
