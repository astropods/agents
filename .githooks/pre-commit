#!/usr/bin/env bash
#
# Pre-commit hook — runs the same per-agent checks as
# .github/workflows/lint.yml via scripts/check-agent.sh, but only for the
# agent directories with staged changes.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Skip typecheck (faster):
#   SKIP_TYPECHECK=1 git commit ...
#
# Bypass the hook entirely:
#   git commit --no-verify ...

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && exit 0

agents=()
while IFS= read -r line; do
  agents+=("$line")
done < <(./scripts/list-agents.sh)
(( ${#agents[@]} == 0 )) && exit 0

touched=()
while IFS= read -r file; do
  for agent in "${agents[@]}"; do
    if [[ "$file" == "$agent"/* ]]; then
      case " ${touched[*]:-} " in
        *" $agent "*) ;;
        *) touched+=("$agent") ;;
      esac
      break
    fi
  done
done <<< "$staged"

(( ${#touched[@]} == 0 )) && exit 0

fail=0
for agent in "${touched[@]}"; do
  printf '→ %s\n' "$agent"
  SKIP_INSTALL=1 ./scripts/check-agent.sh "$agent" || fail=1
done

if (( fail )); then
  echo
  echo "Pre-commit checks failed. Fix the issues above, set SKIP_TYPECHECK=1"
  echo "to skip typecheck, or pass --no-verify to bypass the hook entirely."
  exit 1
fi
