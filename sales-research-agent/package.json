{
  "name": "@astropods/sales-research-agent",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Account research assistant — Gong transcript search + Salesforce lookups",
  "scripts": {
    "dev": "bun --watch agent/index.ts",
