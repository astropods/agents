    "@mastra/memory": "^1.28.2",
    "@qdrant/js-client-rest": "^1.17.0",
    "openai": "^4.104.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.9.3"
  }
}
